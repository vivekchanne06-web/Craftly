# Craftly Frontend — Environment Variable Template
# Copy this file to .env and fill in the values for your environment.

# Base URL for all /api/* backend requests.
# Local dev (kubectl port-forward): http://localhost:8080
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8080

# Base URL for Socket.IO agent connections.
# Each sandbox agent is reachable at: <sandboxId>.agent.localhost
# Local dev requires *.agent.localhost to resolve to 127.0.0.1 via hosts file or dnsmasq.
# Production: set to the base domain where *.agent resolves.
VITE_AGENT_BASE_URL=http://localhost:8080
